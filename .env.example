# Variables de entorno del proyecto
# Copia este archivo como .env y rellena los valores. El .env nunca se sube a Git.

# ---- Intranet: MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intranet

# ---- Intranet: Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Intranet: JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Intranet: Google OAuth2 y Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google
GOOGLE_CALENDAR_CREDENTIALS_FILE=

# ---- Intranet: IA generativa (borradores RRSS) ----
AI_API_KEY=
AI_MODEL=

# ---- Intranet: correo SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Intranet: Web Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# ---- Web pública: MySQL / MariaDB ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=web_centro
MYSQL_USER=
MYSQL_PASSWORD=

# ---- Entorno ----
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173
