# ===========================
# Variables de entorno del Proyecto Intermodular
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env a Git
# ===========================

# ---- MongoDB (Intranet) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=intranet_ies_arcas

# ---- Redis (Intranet) ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT (Intranet) ----
JWT_SECRET_KEY=cambiar-por-clave-secreta-segura
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google

# ---- Google Calendar API ----
GOOGLE_CALENDAR_CREDENTIALS_FILE=

# ---- IA Generativa (RRSS) ----
AI_API_KEY=
AI_MODEL=gemini-pro

# ---- Email / SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@iesramonarcas.es

# ---- Web Push ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# ---- MySQL (Web Pública) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=web_ies_arcas
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- Entorno ----
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
